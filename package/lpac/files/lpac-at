#!/bin/sh
# lpac-at —— 让出串口后再跑 lpac
#
# EC200A 的 AT 口同一时刻只能被一个进程占用：wt6285 服务会用 sms_tool
# 抓 AT 口做 CGDCONT/QNETDEVCTL，此时 lpac 会阻塞或报 euicc_init。
# 本包装先停服务、跑完 lpac、再把服务拉起来。
#
# AT 口随模组 USB 组成变化：
#   MBIM/ECM + ACM 组成 → /dev/ttyACM1
#   RNDIS + option 组成 → /dev/ttyUSB1
# 因此这里优先用 uci 配置，未配置则自动探测。

AT_DEV="$(uci -q get lpac.main.at_device)"

# 探测哪个串口真的能跑 AT：模组复位后 ACM 编号会漂移（ACM1 → ACM2），
# 硬编码必然出事。这里逐个试 AT，取第一个回 OK 的口。
probe_at() {
	p="$1"
	[ -c "$p" ] || return 1
	stty -F "$p" 115200 raw -echo -crtscts 2>/dev/null
	rm -f /tmp/lpac-at.probe
	( timeout 2 cat "$p" > /tmp/lpac-at.probe 2>/dev/null & )
	sleep 1
	printf 'AT\r' > "$p" 2>/dev/null
	sleep 1
	grep -qa 'OK' /tmp/lpac-at.probe 2>/dev/null
	# 等探测用的 cat 退出，否则它继续占着端口，lpac 一启动就撞
	sleep 2
}

PICK=""
if [ -n "$AT_DEV" ] && probe_at "$AT_DEV"; then
	PICK="$AT_DEV"
else
	for p in /dev/ttyACM1 /dev/ttyACM0 /dev/ttyACM2 /dev/ttyACM3 \
	         /dev/ttyUSB1 /dev/ttyUSB2 /dev/ttyUSB0 /dev/ttyUSB3; do
		if probe_at "$p"; then PICK="$p"; break; fi
	done
fi
[ -n "$PICK" ] && AT_DEV="$PICK"

SVC=/etc/init.d/wt6285

# 兜底：lpac 卡死或被信号打断时，服务不能一直停着（那等于断网）
restore_svc() {
	[ -x "$SVC" ] && "$SVC" start >/dev/null 2>&1
}
trap restore_svc EXIT INT TERM HUP

[ -x "$SVC" ] && "$SVC" stop >/dev/null 2>&1
sleep 2

# 清理请求方遗留的逻辑通道：每次失败的 lpac/手工 AT 都可能漏一个，
# 通道耗尽后 lpac 只会返回 euicc_init（实测 CCHO 返回号一路上涨到 7）。
# sms_tool 干净开关串口，不会像 cat 那样常驻占口。
if [ -x /usr/bin/sms_tool ]; then
	for n in 1 2 3 4 5 6 7; do
		/usr/bin/sms_tool -d "$AT_DEV" at "AT+CCHC=$n" >/dev/null 2>&1
	done
fi
sleep 1

LPAC_APDU=at
LPAC_APDU_AT_DEVICE="$AT_DEV"
LPAC_APDU_AT_BAUD=115200
export LPAC_APDU LPAC_APDU_AT_DEVICE LPAC_APDU_AT_BAUD

# 通道清理：调用方遗留的逻辑通道会让 lpac 直接 euicc_init
clear_ch() {
	if [ -x /usr/bin/sms_tool ]; then
		for n in 1 2 3 4 5 6 7; do
			/usr/bin/sms_tool -d "$AT_DEV" at "AT+CCHC=$n" >/dev/null 2>&1
		done
	fi
}

# UIM 复位：通道清不掉时才用，会短暂断网
reset_uim() {
	if [ -x /usr/bin/sms_tool ]; then
		/usr/bin/sms_tool -d "$AT_DEV" at "AT+CFUN=0" >/dev/null 2>&1
		sleep 5
		/usr/bin/sms_tool -d "$AT_DEV" at "AT+CFUN=1" >/dev/null 2>&1
		sleep 12
	fi
}

# 关键：重试必须在"服务仍处于 stop"期间做。
# 之前把重试放在 esim.lua 里，那时 lpac-at 退出时 trap 已把 wt6285 服务拉起，
# AT 口被占，清通道/CFUN 全部静默失败——这是自动恢复一直不生效的真正原因。
#
# 下载要保留实时进度，所以不做缓冲重试；其余动作缓冲后按需重试。
if [ "$1" = "profile" ] && [ "$2" = "download" ]; then
	timeout 180 /usr/bin/lpac "$@"
	rc=$?
else
	OUT=$(mktemp /tmp/lpac-at.XXXXXX)
	timeout 180 /usr/bin/lpac "$@" > "$OUT" 2>&1
	rc=$?
	if [ $rc -ne 0 ] && grep -q "euicc_init" "$OUT" 2>/dev/null; then
		clear_ch
		sleep 2
		timeout 180 /usr/bin/lpac "$@" > "$OUT" 2>&1
		rc=$?
		if [ $rc -ne 0 ] && grep -q "euicc_init" "$OUT" 2>/dev/null; then
			reset_uim
			timeout 180 /usr/bin/lpac "$@" > "$OUT" 2>&1
			rc=$?
		fi
	fi
	cat "$OUT"
	rm -f "$OUT"
fi

# 跑完再清一次：下载/启用等中途失败时 lpac 可能来不及关通道，
# 残留会让下一次调用直接 euicc_init（实测下载成功后立刻读通知就撞上）。
if [ -x /usr/bin/sms_tool ]; then
	for n in 1 2 3 4 5 6 7; do
		/usr/bin/sms_tool -d "$AT_DEV" at "AT+CCHC=$n" >/dev/null 2>&1
	done
fi

exit $rc
