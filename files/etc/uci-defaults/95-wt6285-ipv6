#!/bin/sh
# WT6285 first-boot defaults: IPv6 开箱可用
# wan6 本身由 99-wt6285 创建（usb0 / dhcpv6），这里补上出网与读取位置。

# 1) wan 区开启 IPv6 masquerade
#    运营商不给前缀委派（PD）时，LAN 的 ULA 需要 NAT66 才能出网
zone="$(uci show firewall 2>/dev/null | sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name='wan'$/\1/p" | head -1)"
[ -n "$zone" ] && uci -q set "firewall.$zone.masq6=1"

# 2) 短信默认读模块内存（ME），SM 通常为空
if [ -x /usr/bin/sms_tool ]; then
	uci -q set sms_tool.general.storage='ME'
	uci -q commit sms_tool
fi

uci -q commit firewall
exit 0
