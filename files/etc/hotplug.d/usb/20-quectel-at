#!/bin/sh
# EC200A 在 ECM 组成下把 AT 口做成 CDC-ACM 接口；
# 本固件未内置 cdc_acm 时，用 option 驱动强制接管，恢复 /dev/ttyUSB*。
case "$PRODUCT" in
  2c7c/6005/*)
    [ -d /sys/bus/usb-serial/drivers/option1 ] || exit 0
    ls /dev/ttyUSB0 >/dev/null 2>&1 && exit 0
    echo "2c7c 6005" > /sys/bus/usb-serial/drivers/option1/new_id 2>/dev/null
    logger -t quectel-at "bound 2c7c:6005 to option, ttyUSB restored"
    ;;
esac
exit 0
