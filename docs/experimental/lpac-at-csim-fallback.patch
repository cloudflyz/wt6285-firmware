+            }
+            sw1 = rx[rx_len - 2];
+            sw2 = rx[rx_len - 1];
+            free(rx);
+            rx = NULL;
+        }
+
+        if (sw1 != 0x90)
+            return -1;
+
+        logic_channel = 1;
+        return logic_channel;
+    }
