+/* 发送一条 CSIM APDU：必须读到 OK/ERROR 才返回，
+ * 否则残留的 OK 会和下一条命令的 echo 混在一起（实测会把 AT+CSIM 拆成 AT+C0）。 */
+static int csim_apdu(const uint8_t *tx, uint32_t tx_len, uint8_t **rx, uint32_t *rx_len) {
+    char *hexstr = NULL;
+    int ret = -1;
+    size_t cmd_len = tx_len * 2 + 32;
+    char *cmd = malloc(cmd_len);
+
+    *rx = NULL;
+    *rx_len = 0;
+
+    if (!cmd)
+        return -1;
+
+    int off = snprintf(cmd, cmd_len, "AT+CSIM=%u,\"", tx_len * 2);
+    for (uint32_t i = 0; i < tx_len; i++)
+        off += snprintf(cmd + off, cmd_len - off, "%02X", (uint8_t)(tx[i] & 0xFF));
+    snprintf(cmd + off, cmd_len - off, "\"\r\n");
+
+    fwrite(cmd, 1, strlen(cmd), fuart);
+    free(cmd);
+
+    /* 读到 OK 或 ERROR 为止，中途记下 +CSIM: 那一行 */
+    while (1) {
+        memset(buffer, 0, AT_BUFFER_SIZE);
+        if (!fgets(buffer, AT_BUFFER_SIZE, fuart))
+            goto out;
+        buffer[strcspn(buffer, "\r\n")] = 0;
+        if (getenv_or_default(ENV_AT_DEBUG, false))
+            printf("AT_DEBUG: %s\n", buffer);
+
+        if (strncmp(buffer, "+CSIM: ", 7) == 0) {
+            free(hexstr);
+            hexstr = strdup(buffer + 7);
+            continue;
+        }
+        if (strcmp(buffer, "OK") == 0) {
+            ret = 0;
+            goto out;
+        }
+        if (strcmp(buffer, "ERROR") == 0)
+            goto out;
+    }
+
+out:
+    if (ret == 0 && hexstr) {
+        char *part;
+        strtok(hexstr, ",");
+        part = strtok(NULL, ",");
+        if (part) {
+            if (part[0] == '"')
+                part++;
+            part[strcspn(part, "\"")] = '\0';
+
+            *rx_len = strlen(part) / 2;
+            *rx = malloc(*rx_len ? *rx_len : 1);
+            if (*rx) {
+                int n = euicc_hexutil_hex2bin_r(*rx, *rx_len, part, strlen(part));
+                if (n < 0) {
+                    free(*rx);
+                    *rx = NULL;
+                    *rx_len = 0;
+                    ret = -1;
+                } else {
+                    *rx_len = n;
+                }
+            } else {
+                ret = -1;
+            }
+        } else {
+            ret = -1;
+        }
+    }
+    free(hexstr);
+    return ret;
+}
