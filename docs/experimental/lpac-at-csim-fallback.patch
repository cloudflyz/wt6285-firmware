+/* CSIM 模式：单条 APDU，遇 61xx 自动续传 GET RESPONSE */
+static int csim_transmit(uint8_t **rx, uint32_t *rx_len, const uint8_t *tx, uint32_t tx_len) {
+    uint8_t *acc = NULL;
+    uint32_t acc_len = 0;
+    uint8_t *stage = NULL;
+    uint32_t stage_len = 0;
+    const uint8_t *cur = tx;
+    uint32_t cur_len = tx_len;
+    uint8_t getresp[5] = {0x00, 0xC0, 0x00, 0x00, 0x00};
+    int round;
+
+    for (round = 0; round < 8; round++) {
+        if (csim_apdu(cur, cur_len, &stage, &stage_len))
+            goto err;
+        if (stage_len < 2)
+            goto err;
+
+        uint8_t *grown = realloc(acc, acc_len + stage_len);
+        if (!grown)
+            goto err;
+        acc = grown;
+        memcpy(acc + acc_len, stage, stage_len);
+        acc_len += stage_len;
+
+        uint8_t sw1 = stage[stage_len - 2];
+        uint8_t sw2 = stage[stage_len - 1];
+        free(stage);
+        stage = NULL;
+
+        if (sw1 == 0x61) {
+            getresp[4] = sw2 ? sw2 : 0x00;
+            cur = getresp;
+            cur_len = sizeof(getresp);
+            continue;
+        }
+        break;
+    }
+
+    *rx = acc;
+    *rx_len = acc_len;
+    return 0;
+
+err:
+    free(stage);
+    free(acc);
+    *rx = NULL;
+    *rx_len = 0;
+    return -1;
 }
 
