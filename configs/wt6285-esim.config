# NRadio WT6285 — seeded defconfig (kernel 5.10)
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_nradio_wt6285=y

# base system
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
# 无线页面：客户端模式（STA）需在 LuCI 里扫描/加入上游
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ntpdate=y

# 4G module
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_usb-modeswitch=y

# ECM/MBIM 组成下 AT 口走 CDC-ACM
CONFIG_PACKAGE_kmod-usb-acm=y

# SMS
CONFIG_PACKAGE_sms-tool=y

# dialer (quectel-CM 5G, from Lienol/openwrt qmodem)
CONFIG_PACKAGE_quectel-cm-5g=y
CONFIG_PACKAGE_libjson-c=y

# wifi (MT7628 built-in 2.4G)
CONFIG_PACKAGE_kmod-mt7603=y
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# usb modem extras
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_usb-modeswitch-data=y

# LuCI panel
CONFIG_PACKAGE_luci-app-wt6285=y
# eSIM：lpac 走 AT 逻辑通道（CCHO/CGLA），EC200A 实测可用
CONFIG_PACKAGE_lpac=y

# ===== lite: 精简 A 档（2026-11-01） =====
# ssr-plus 全家桶
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_ssr-plus is not set
# CONFIG_PACKAGE_shadowsocksr-libev is not set
# CONFIG_PACKAGE_microsocks is not set
# CONFIG_PACKAGE_dns2tcp is not set
# 无用默认包
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# CONFIG_PACKAGE_nlbwmon is not set
# CONFIG_PACKAGE_nping is not set
# CONFIG_PACKAGE_wget-ssl is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set

# CONFIG_DEFAULT_luci-app-ssr-plus is not set
# CONFIG_DEFAULT_luci-app-upnp is not set
# CONFIG_DEFAULT_luci-app-ddns is not set
# CONFIG_DEFAULT_luci-app-wol is not set

# ===== TLS 统一到 OpenSSL =====
CONFIG_PACKAGE_wpad-basic-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-conf=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_LIBCURL_OPENSSL=y

# ===== 精简：移除无用组件 =====
# FTP 服务（完全用不到）
# CONFIG_PACKAGE_vsftpd is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-i18n-vsftpd-zh-cn is not set
# CONFIG_DEFAULT_luci-app-vsftpd is not set

# KMS 激活服务
# CONFIG_PACKAGE_vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn is not set
# CONFIG_DEFAULT_luci-app-vlmcsd is not set

# 流量统计（持续写 flash，收益低）
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
# CONFIG_PACKAGE_luci-lib-chartjs is not set
# CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn is not set
# CONFIG_DEFAULT_luci-app-nlbwmon is not set

# DDNS（本机不做动态域名）
# CONFIG_PACKAGE_ddns-scripts is not set
# CONFIG_PACKAGE_ddns-scripts-services is not set
# CONFIG_PACKAGE_ddns-scripts_aliyun is not set
# CONFIG_PACKAGE_ddns-scripts_dnspod is not set

# OUI 厂商库（205 KB）
# CONFIG_PACKAGE_oui is not set
# CONFIG_PACKAGE_luci-app-oui is not set
# CONFIG_DEFAULT_luci-app-oui is not set

# 跑分工具 / 一次性对时（sysntpd 已在跑）
# CONFIG_PACKAGE_coremark is not set
# CONFIG_PACKAGE_ntpdate is not set

# iptables 扩展（firewall4 走 nftables；保留 iptables 本体做兼容）
# CONFIG_PACKAGE_iptables-mod-extra is not set
# CONFIG_PACKAGE_iptables-mod-tproxy is not set
# CONFIG_PACKAGE_kmod-ipt-tproxy is not set
# CONFIG_PACKAGE_kmod-nf-tproxy is not set
# CONFIG_PACKAGE_kmod-nft-tproxy is not set
# CONFIG_PACKAGE_ip6tables is not set
# CONFIG_PACKAGE_ipset is not set

# ===== 关闭 cryptodev（MT7628 无硬件加密引擎）=====
# 依赖来自 OPENSSL_ENGINE_BUILTIN_DEVCRYPTO / libopenssl-devcrypto，
# 关掉这个符号才能一起去掉，否则只是删包会被依赖卡住
# CONFIG_OPENSSL_ENGINE_BUILTIN_DEVCRYPTO is not set
# CONFIG_PACKAGE_libopenssl-devcrypto is not set
# CONFIG_PACKAGE_kmod-cryptodev is not set

# ===== 默认主题 Vantage =====
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-app-vantage=y
